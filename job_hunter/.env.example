# ─── Google Gemini (LLM) ──────────────────────────────────────────────────────
# Obtén tu API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://jobhunter:CHANGE_ME@postgres:5432/jobhunter_db

# ─── Autenticación (JWT) ──────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=CHANGE_ME_IN_PRODUCTION

# ─── OTP (hereda AUTH_SECRET si no se especifica) ────────────────────────────
OTP_SECRET=

# ─── SMTP / Email OTP ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
# Para Gmail: genera una "App Password" en myaccount.google.com/apppasswords
SMTP_PASS=
EMAIL_FROM=tu-email@gmail.com
EMAIL_FROM_NAME=Job Hunter

# ─── WhatsApp OTP — Opción A: Meta Cloud API (recomendado) ───────────────────
# Configura un número en https://developers.facebook.com/apps → WhatsApp
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── WhatsApp OTP — Opción B: Twilio (alternativa) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Formato: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# ─── WhatsApp OTP — Opción C: Bot local (fallback desarrollo) ─────────────────
WHATSAPP_API_URL=http://localhost:3001/send
WHATSAPP_BOT_NUMBER=

# ─── Telegram Bot (opcional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# ─── URL de la API (para referencias internas) ───────────────────────────────
API_BASE_URL=http://localhost:8000
